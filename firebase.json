{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "predeploy": [
      "npm --prefix functions run preflight:rules"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix functions run preflight:deploy",
        "npm --prefix functions run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|wasm)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "ios": {
        "default": {
          "projectId": "demo-project",
          "appId": "1:849252210850:ios:b5336894cde77728d65ffb",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "demo-project",
          "configurations": {
            "android": "1:849252210850:android:bceb4235c64991bbd65ffb",
            "ios": "1:849252210850:ios:b5336894cde77728d65ffb",
            "web": "1:849252210850:web:c923ea46169102d7d65ffb"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "demo-project",
          "appId": "1:849252210850:android:bceb4235c64991bbd65ffb",
          "fileOutput": "android/app/google-services.json"
        }
      }
    }
  }
}
