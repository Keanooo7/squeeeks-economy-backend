{
  "name": "functions",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "preflight:rules": "tsc && node lib/rulesPreflightCli.js",
    "preflight:deploy": "node scripts/preflight-deploy.cjs",
    "test": "jest",
    "test:rules": "node scripts/with-jdk.cjs firebase emulators:exec --config ../firebase.rules.json --only firestore --project demo-cleaning-rules \"jest --testPathIgnorePatterns=/node_modules/ --testMatch **/firestore-rules.test.ts\"",
    "test:e2e": "npm run build && node scripts/with-jdk.cjs firebase emulators:exec --config ../firebase.e2e.json --only firestore,auth,functions --project demo-cleaning-e2e \"jest --config jest.e2e.config.js --runInBand\"",
    "floor": "node scripts/check-test-floor.cjs all",
    "floor:unit": "node scripts/check-test-floor.cjs unit",
    "floor:rules": "node scripts/check-test-floor.cjs rules",
    "floor:e2e": "node scripts/check-test-floor.cjs e2e",
    "floor:ratchet": "node scripts/check-test-floor.cjs all --ratchet",
    "floor:record": "node scripts/check-test-floor.cjs all --record",
    "census:push-tokens": "npm run build && node scripts/count-legacy-push-tokens.cjs",
    "seed:gen": "node scripts/gen-seed.cjs",
    "seed:check": "jest src/__tests__/seedCheck.test.ts"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@apple/app-store-server-library": "^3.1.0",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jsrsasign": "^10.5.15",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "eslint": "^8.9.0",
    "firebase": "^10.14.1",
    "firebase-functions-test": "^3.4.0",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.3",
    "jsrsasign": "^11.1.3",
    "ts-jest": "^29.2.0",
    "typescript": "^5.0.4"
  },
  "private": true
}
